{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:go",
    "github>Netcracker/renovate-config:netcracker-dependencies",
    "github>Netcracker/renovate-config:annotated-versions"
  ],
  "prConcurrentLimit": 20,
  "packageRules": [
    {
      "description": "All other 3rd party Docker images",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["!ghcr.io/netcracker/**", "!alpine"],
      "groupName": "docker-deps"
    },
    {
      "description": "Alpine packages installed in the runtime image",
      "matchDatasources": ["repology"],
      "matchPackageNames": ["alpine_*/**"],
      "groupName": "alpine-packages"
    },
    {
      "description": "Monitoring operator Go modules",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/prometheus-operator/**", "github.com/VictoriaMetrics/**"],
      "groupName": "go-monitoring"
    },
    {
      "description": "Alpine runtime image and synchronized package repositories",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "groupName": "alpine-release"
    }
  ]
}
